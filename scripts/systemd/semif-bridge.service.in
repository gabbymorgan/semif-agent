[Unit]
Description=SemIf agent third-party API bridges (SimpleX forwarding)
After=network-online.target semif-simplex-forward.service
Wants=network-online.target semif-simplex-forward.service

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=HF_HOME=@REPO@/.runtime/hf
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO@/.runtime/venv/bin/python -m semif_agent.cli bridge
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=semif-bridge

[Install]
WantedBy=default.target
