[Unit]
Description=SemIf agent messenger gateway (SimpleX, LXMF)
After=network-online.target semif-simplex.service
Wants=network-online.target semif-simplex.service

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment=HF_HOME=@REPO@/.runtime/hf
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO@/.runtime/venv/bin/python -m semif_agent.cli gateway --platform all
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=semif-gateway

[Install]
WantedBy=default.target
